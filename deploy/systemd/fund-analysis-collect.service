[Unit]
Description=Fund analysis scheduled collection and reconciliation
Requires=fund-analysis.service
After=fund-analysis.service

[Service]
Type=oneshot
User=fund-analysis
Group=fund-analysis
WorkingDirectory=/opt/fund-analysis/current
Environment=TZ=Asia/Shanghai
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/fund-analysis/current/.venv/bin/fund-analysis collect --port 8765 --scheduled
TimeoutStartSec=660
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
